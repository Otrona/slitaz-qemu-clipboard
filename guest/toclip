#!/bin/sh
# toclip -c    : send the guest clipboard to the host
# toclip file  : send a file
# cmd | toclip : send command output
# Needs host/vmclip.py running on the host; -c needs xclip or xsel.
URL=http://10.0.2.2:8765/
if [ "$1" = "-c" ]; then
	if command -v xclip >/dev/null; then
		xclip -o -selection clipboard
	else
		xsel -ob
	fi
else
	cat "${1:--}"
fi | curl -s --data-binary @- "$URL" && echo "Sent to host clipboard"
